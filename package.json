{
  "name": "monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": ["apps/*", "shared"],
  "scripts": {
    "dev": "bun run --filter '*' --parallel dev",
    "start": "bun run --filter @app/backend start",
    "test": "bun run --filter @app/backend test",
    "db:push": "bun run --filter @app/backend db:push",
    "db:test:push": "bun run --filter @app/backend db:test:push",
    "db:studio": "bun run --filter @app/backend db:studio",
    "db:seed-admin": "bun run --filter @app/backend db:seed-admin",
    "payments:reconcile": "bun run --filter @app/backend payments:reconcile"
  }
}
