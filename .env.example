NODE_ENV=development
SERVER_PORT=8000

BETTER_AUTH_URL=http://localhost:8000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
CLIENT_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set either DB_URL, or every field below it - never both, never a mix.
# docker compose (local dev) needs the discrete fields regardless, since the
# postgres image bootstraps itself from them, not a connection string.
DB_URL=

DB_PROVIDER=postgresql
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

# Set either REDIS_URL, or every field below it - never both, never a mix.
# docker compose (local dev) needs the discrete fields regardless, since the redis image is
# started with --requirepass from them, not a connection string.
REDIS_URL=

REDIS_PROVIDER=redis
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
# Defaults: REDIS_USER=default (Redis's own default ACL user - only set this if you've configured
# a different one), REDIS_DB=0 (the logical database index, 0-15)

# Comma-separated IPs/CIDRs of your own reverse proxies (e.g. 10.0.0.0/8), so rate limiting can
# tell clients apart behind a multi-hop X-Forwarded-For. One of this or TRUSTED_IP_HEADER is
# required in production - startup refuses to run without either, since unset a client can spoof
# a new IP per request to dodge rate limits, or everyone behind the proxy shares one bucket so one
# client's flood locks out the rest. Safe to leave both empty in development/test.
TRUSTED_PROXIES=

# Name of a header your platform's edge sets directly with the real client IP, when its own IPs
# aren't a pinnable CIDR range for TRUSTED_PROXIES above (most managed platforms): e.g. Fly.io's
# Fly-Client-IP, Cloudflare's CF-Connecting-IP, Vercel's x-vercel-forwarded-for, Netlify's
# x-nf-client-connection-ip.
TRUSTED_IP_HEADER=

LOG_LEVEL=info
