NODE_ENV=development
SERVER_PORT=8000

BETTER_AUTH_URL=http://localhost:8000
# openssl rand -base64 32
BETTER_AUTH_SECRET=
CLIENT_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set either DB_URL, or every field below it - never both, never a mix.
# docker compose (local dev) needs the discrete fields regardless, since the
# postgres image bootstraps itself from them, not a connection string.
DB_URL=

DB_PROVIDER=postgresql
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Comma-separated IPs/CIDRs of your own reverse proxies (e.g. 10.0.0.0/8), so rate limiting can
# tell clients apart behind a multi-hop X-Forwarded-For. Leave empty if there's at most one hop.
TRUSTED_PROXIES=

LOG_LEVEL=info
